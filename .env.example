# docker-compose 用の環境変数。
# 使い方:
#   1. このファイルを `.env` という名前でコピー (リポジトリにコミットしない)
#   2. 必要な値を埋める (空のままなら docker-compose.yml の既定値が使われる)
#   3. `docker compose up -d` で起動
#   4. Setting.mail_from は DB 値なので Redmine 管理 UI で同じ値を設定
#      (管理 → 設定 → メール通知 → 送信元メールアドレス)
#
# 詳細: docs/manual_setup.md §4-1 を参照。
#
# どの変数も「未設定 = docker-compose.yml の既定値を使う」動作になります。
# 必要なものだけコメントアウトを外して値を入れてください。

# ====================================================================
# Compose プロジェクト・コンテナ名 (複数インスタンスを並走させたい場合に変える)
# --------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=redmine
# REDMINE_APP_CONTAINER=redmine-app
# REDMINE_DB_CONTAINER=redmine-db
# REDMINE_MAILPIT_CONTAINER=redmine-mailpit

# ====================================================================
# 公開ポート (ホスト側) — 既存のポートと衝突する場合に変更
# --------------------------------------------------------------------
# REDMINE_PORT=3080         # http://localhost:3080
# MAILPIT_UI_PORT=8025      # http://localhost:8025
# MYSQL_PORT=13306          # mysql client から localhost:13306 で直接接続可能
                            # (例: mysql -h 127.0.0.1 -P 13306 -u redmine -p)
                            # ホストの既定 3306 と衝突しないよう既定値は 13306

# ====================================================================
# データベース (MySQL)
# 本番運用時はパスワードを必ず変更すること
# --------------------------------------------------------------------
# MYSQL_VERSION=8.0
# MYSQL_DATABASE=redmine
# MYSQL_USER=redmine
# MYSQL_PASSWORD=redmine_pw
# MYSQL_ROOT_PASSWORD=redmine_root_pw

# ====================================================================
# Redmine アプリ
# 本番運用時は SECRET_KEY_BASE を必ず変更すること
# (例: openssl rand -hex 64 で 128 桁のランダム文字列を生成)
# --------------------------------------------------------------------
# REDMINE_SECRET_KEY_BASE=please_change_this_secret_key_base
# TZ=Asia/Tokyo

# ====================================================================
# Mailpit イメージ (バージョン固定したい場合)
# --------------------------------------------------------------------
# MAILPIT_IMAGE=axllent/mailpit:latest

# ====================================================================
# プロキシ設定 (直接インターネットに出られない環境用)
# --------------------------------------------------------------------
# 用途:
#   - ビルド時: apt-get update / git clone https://github.com/... が外部に出る
#   - 実行時: Redmine からの HTTP/HTTPS リクエスト (アバター取得、外部連携 等)
#
# 大文字版 (HTTP_PROXY 等) と小文字版 (http_proxy 等) は Linux では
# 別変数として扱われる。多くのツールは両方をサポートしているが、
# wget / curl / ruby net/http など小文字を優先するものもあるため、
# 通常は両方に同じ値を設定するのが安全。
#
# NO_PROXY には Docker 内部ネットワークのサービス名 (db, mailpit) と
# localhost を含めて、コンテナ間通信がプロキシ経由にならないようにする。
# --------------------------------------------------------------------
# 大文字版
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,db,mailpit,.svc.cluster.local
#
# 小文字版
# http_proxy=http://proxy.example.com:8080
# https_proxy=http://proxy.example.com:8080
# no_proxy=localhost,127.0.0.1,db,mailpit,.svc.cluster.local

# ====================================================================
# Mailpit を使わない場合 (本番環境など)
# --------------------------------------------------------------------
# 以下 2 箇所を docker-compose.yml でコメントアウトする:
#
# (1) services 直下の mailpit: サービスブロック全体
#       # mailpit:
#       #   image: ...
#       #   ...
#
# (2) redmine の depends_on: 配下の mailpit エントリ 3 行
#       depends_on:
#         db:
#           condition: service_healthy
#         # mailpit:
#         #   condition: service_started
#         #   required: false
#
# (注) Compose の制約上、depends_on で参照しているサービスが
#      コメントアウトで消えると "未定義サービス" として弾かれるため、
#      depends_on の該当エントリも一緒にコメントアウトする必要があります。
#
# また、SMTP_PROVIDER が 'mailpit' のままだと Redmine が存在しない
# コンテナに SMTP 接続を試みてメール送信時にエラーログが出るので、
# SMTP_PROVIDER=gmail または =custom に切り替えてください。

# ====================================================================
# SMTP 設定 (詳細は docs/manual_setup.md §4-1)
# ====================================================================

# --------------------------------------------------------------------
# Mailpit を使う場合 (開発デフォルト): 何も設定しなくて良い
# --------------------------------------------------------------------

# ====================================================================
# Gmail SMTP を使う場合: 以下を設定
# --------------------------------------------------------------------
# 前提:
#   - Google アカウントで 2 段階認証 (2FA) が ON になっていること
#   - https://myaccount.google.com/apppasswords で「アプリパスワード」を発行
#     (16 桁の英字; "abcd efgh ijkl mnop" の形だがスペースは無視で OK)
#   - 送信元 (From) は GMAIL_USER と同じアドレスに合わせる
#   - 送信上限: 個人 Gmail 1 日 500 通 / Workspace 2000 通
# ====================================================================
# SMTP_PROVIDER=gmail
# GMAIL_USER=your.address@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=your.address@gmail.com

# ====================================================================
# 任意の SMTP サーバーを使う場合: 以下を設定
# (自前のメールリレー / SendGrid / Amazon SES / Office 365 など、
#  SMTP プロトコルで受け付けるサーバー全般)
# --------------------------------------------------------------------
# よくあるパターン:
#
# (1) 認証なし・ポート 25 のリレーサーバー
#     SMTP_PROVIDER=custom
#     SMTP_HOST=smtp.example.com
#     SMTP_PORT=25
#     SMTP_DOMAIN=example.com
#     SMTP_FROM=redmine@example.com
#
# (2) 認証あり STARTTLS・ポート 587 (もっとも一般的)
#     SMTP_PROVIDER=custom
#     SMTP_HOST=smtp.example.com
#     SMTP_PORT=587
#     SMTP_DOMAIN=example.com
#     SMTP_USER=svc-redmine
#     SMTP_PASSWORD=<service-account password>
#     SMTP_AUTH=login          # login / plain / cram_md5 のいずれか
#     SMTP_STARTTLS=true
#     SMTP_TLS_VERIFY=peer     # プライベート CA / 自己署名証明書なら none
#     SMTP_OPENSSL_CA_FILE=    # プライベート CA を信頼する場合のみパス指定
#     SMTP_FROM=redmine@example.com
#
# (3) SendGrid (API key を SMTP パスワードとして使う SaaS の典型)
#     SMTP_PROVIDER=custom
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_PORT=587
#     SMTP_DOMAIN=sendgrid.net
#     SMTP_USER=apikey
#     SMTP_PASSWORD=<SendGrid API key>
#     SMTP_AUTH=login
#     SMTP_STARTTLS=true
#     SMTP_TLS_VERIFY=peer
#     SMTP_FROM=noreply@your-verified-domain.com
# ====================================================================


# ####################################################################
# # Mode B 用 (FastAPI ブリッジ)
# #
# # 起動: docker compose -f docker-compose.yml -f compose.api.yml up -d
# # ドキュメント:
# #   - api/README.md (エンドポイント仕様)
# #   - docs/manual_setup.md §1, §2 (Redmine 側のロール / ユーザー設定)
# ####################################################################

# ====================================================================
# Mode B: コンテナ名・公開ポート
# --------------------------------------------------------------------
# REDMINE_API_CONTAINER=redmine-api
# API_PORT=8000              # http://localhost:8000  (Swagger は /docs)

# ====================================================================
# Mode B: Redmine への認証情報 (api/ サービスから REST を叩くため必須)
# --------------------------------------------------------------------
# 優先順:
#   1. REDMINE_API_KEY (推奨)         — 管理者の API アクセスキー
#   2. REDMINE_ADMIN_USERNAME / _PASSWORD (フォールバック)
#
# Redmine 管理者の API キーの取り出し方:
#   admin でログイン → 個人設定 → 右ペイン「API アクセスキー」→ 表示 / リセット
# --------------------------------------------------------------------
# REDMINE_URL=http://redmine:3000     # docker-compose 内のサービス名
# REDMINE_API_KEY=
# REDMINE_ADMIN_USERNAME=admin
# REDMINE_ADMIN_PASSWORD=

# ====================================================================
# Mode B: 質問者アカウント作成時の参加先 (POST /users で使用)
# --------------------------------------------------------------------
# QUESTIONER_PROJECT_IDENTIFIER=demo  # Redmine の Project identifier
# QUESTIONER_ROLE_NAME=質問者          # Redmine 上のロール名 (完全一致)
# QUESTIONER_LANGUAGE=ja              # 新規作成ユーザーの言語

# ====================================================================
# Mode B: 問い合わせチケット起票先 (POST /tickets で使用)
# --------------------------------------------------------------------
# INQUIRY_PROJECT_IDENTIFIER=         # 空ならアカウント作成と同じプロジェクト
# INQUIRY_TRACKER_NAME=               # 例: Support。空ならプロジェクトの先頭トラッカー
# RESPONDER_ROLE_NAME=回答者          # 起票時に watcher へ自動追加する対象ロール

# ====================================================================
# Mode B: 質問者になりすまして起票 (impersonation)
# --------------------------------------------------------------------
# true: 起票時に質問者本人を author にする (private チケットを本人が
#       閲覧可能にするため。質問者ロールに add_issues 権限が必須。
#       docs/manual_setup.md §1-1 参照)
# false: admin が author になる (旧挙動)
# --------------------------------------------------------------------
# CREATE_TICKET_AS_QUESTIONER=true

# ====================================================================
# Mode B: チャットボット起票識別用カスタムフィールド ID
# --------------------------------------------------------------------
# 0 (既定) なら無効。Redmine 上で `Chatbot Session` カスタムフィールドを
# 作って、その ID をここに入れると、チャットボット経由の起票時に
# session ID が自動記録される (UI 直叩きの起票と区別するための監査用)。
# フィールド作成手順: docs/manual_setup.md §9-2
# --------------------------------------------------------------------
# CHATBOT_SESSION_CUSTOM_FIELD_ID=0


# ####################################################################
# # Mode C 用 (RAG チャットボット + Ollama + ChromaDB + Streamlit)
# #
# # 起動: docker compose -f docker-compose.yml \
# #                      -f compose.api.yml \
# #                      -f compose.chatbot.yml up -d
# # ドキュメント:
# #   - chatbot/README.md (内部設計)
# #   - docs/chatbot_usage.md (利用者向けマニュアル)
# #   - docs/view_customize_setup.md (UI 抑止の設定)
# #   - docs/manual_setup.md §9 (Redmine 側追加設定)
# ####################################################################

# ====================================================================
# Mode C: コンテナ名・公開ポート
# --------------------------------------------------------------------
# OLLAMA_IMAGE=ollama/ollama:latest
# OLLAMA_CONTAINER=redmine-ollama
# OLLAMA_PORT=11435              # ホスト 11435 → コンテナ 11434
#                                  既定の 11434 だとホストの別 Ollama と衝突するためずらしてある
# CHATBOT_CONTAINER=redmine-chatbot
# CHATBOT_PORT=8100              # http://localhost:8100  (Chatbot バックエンド)
# CHATBOT_FRONTEND_CONTAINER=redmine-chatbot-ui
# CHATBOT_FRONTEND_PORT=8501     # http://localhost:8501  (Streamlit UI)

# ====================================================================
# Mode C: Redmine 公開 URL (citation・通知メールのリンクに使う)
# --------------------------------------------------------------------
# ブラウザから Redmine にアクセスする URL。コンテナ内部の
# REDMINE_URL (http://redmine:3000) と区別すること。
# 既定値はローカル開発を想定。本番では https://redmine.example.com 等に。
# --------------------------------------------------------------------
# REDMINE_PUBLIC_URL=http://localhost:3080

# ====================================================================
# Mode C: クローラ (Redmine → VectorDB)
# --------------------------------------------------------------------
# CRAWL_PROJECT_IDENTIFIER=demo  # 取込対象プロジェクト
# CRAWL_INCLUDE_JOURNALS=true    # コメント (notes 付き journal) も取り込むか
# CRAWL_EXCLUDE_PRIVATE=true     # private チケットを VectorDB から除外 (推奨)
# CRAWL_INTERVAL_MINUTES=0       # 自動 crawl の間隔。0 = 手動のみ

# ====================================================================
# Mode C: ベクトル DB (Chroma)
# --------------------------------------------------------------------
# CHROMA_COLLECTION=redmine_tickets

# ====================================================================
# Mode C: LLM プロバイダ既定 (UI で各セッションごとに上書き可)
# --------------------------------------------------------------------
# LLM_PROVIDER_DEFAULT=ollama    # ollama | openai

# ====================================================================
# Mode C: Ollama (LLM 推論 + 埋め込み)
# --------------------------------------------------------------------
# OLLAMA_LLM_MODEL=qwen2.5:7b           # 主な LLM。事前に `ollama pull` 必要
# OLLAMA_EMBED_MODEL=nomic-embed-text   # 埋め込みモデル

# ====================================================================
# Mode C: OpenAI / OpenAI 互換 API (LLM のみ。埋め込みは Ollama 固定)
# --------------------------------------------------------------------
# UI でユーザーが API キーを入れるのが基本。ここの環境変数はフォールバック。
# OpenAI 互換ゲートウェイ (Azure / LiteLLM / vLLM 等) を社内既定にしたい
# 場合は OPENAI_BASE_URL_DEFAULT を指定 (UI 入力欄の初期値になる)。
# --------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL_DEFAULT=gpt-4o-mini
# OPENAI_BASE_URL_DEFAULT=             # 例: https://my-gw.example.com/v1

# ====================================================================
# Mode C: RAG パラメータ
# --------------------------------------------------------------------
# RETRIEVAL_TOP_K=5              # 検索ヒット件数
# LLM_TEMPERATURE=0.2            # 推論温度
# LLM_MAX_TOKENS=1024            # 生成上限

# ====================================================================
# Mode C: エスカレーション先 (api/ サービスへの内部 URL)
# --------------------------------------------------------------------
# BRIDGE_API_URL=http://api:8000
# ====================================================================
